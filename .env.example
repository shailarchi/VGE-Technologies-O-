# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Polygon Network DLT / EVM Smart Contract Integration
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0x71C7656EC7ab88b098defB751B7401B5f6d8976F
ADMIN_PRIVATE_KEY=your_testnet_private_key_here

# PostgreSQL Database Connection
DATABASE_URL=postgresql://verde_admin:secure_password@localhost:5432/verdegrid

# API Security & Authentication
API_SECRET_KEY=your_jwt_secret_key_here
FASTAPI_ENV=production

# Stripe SaaS Billing Configuration
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Transak Fiat-to-Crypto dREC Marketplace SDK
TRANSAK_API_KEY=your_transak_api_key_here
TRANSAK_ENVIRONMENT=STAGING

# Monerium EURe B2B Atomic Settlement (SEPA IBAN)
MONERIUM_CLIENT_ID=vge_monerium_eure_client
MONERIUM_SEPA_IBAN=EE893300220123456789

# Polygon Gas Sponsorship (AWS KMS + Kraken Liquidity Flow)
AWS_KMS_GAS_KEY_ID=arn:aws:kms:eu-central-1:123456789012:key/vge-polygon-gas-sponsor
